# URL base do app, usada para gerar QR code que o celular escaneia.
# O QR code codifica: ${NEXT_PUBLIC_BASE_URL}/entrada/confirmar?token=<uuid>
# Em producao: https://meu-parking.com
# Padrao dev:
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Chave secreta usada para assinar e verificar JWTs de admin.
# Em producao: gere uma chave forte com `openssl rand -base64 32`
# Padrao dev (NUNCA usar em producao):
JWT_SECRET=dev-secret-change-in-prod
